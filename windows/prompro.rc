1 ICON "prompro.ico"

1 VERSIONINFO
FILEVERSION 1,6,0,0
PRODUCTVERSION 1,6,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mickey W. Lawless"
      VALUE "FileDescription", "PROMPRO - EPROM Data Reader and Hex Editor"
      VALUE "FileVersion", "1.6"
      VALUE "InternalName", "PROMPRO"
      VALUE "LegalCopyright", "Copyright (c) 2025 Mickey W. Lawless"
      VALUE "OriginalFilename", "PROMPRO.EXE"
      VALUE "ProductName", "PROMPRO"
      VALUE "ProductVersion", "1.6"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
